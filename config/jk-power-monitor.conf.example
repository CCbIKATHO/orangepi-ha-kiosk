# Orange Pi PC Plus physical pin 11 = PA1 = gpiochip0 line 1
POWER_GPIO_CHIP=gpiochip0
POWER_GPIO_LINE=1

# Set after testing the module:
# 0 = AC present when GPIO reads 0
# 1 = AC present when GPIO reads 1
POWER_PRESENT_VALUE=0

POWER_POLL_SECONDS=1
POWER_DEBOUNCE_SECONDS=3

# Telegram. Leave empty until BotFather token/chat ID are configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DASHBOARD_API=http://127.0.0.1:8080/api/state
