[Unit]
Description=JK BMS local dashboard backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=winner
WorkingDirectory=/opt/jk-display
EnvironmentFile=/etc/jk-display.conf
ExecStart=/opt/jk-display/venv/bin/python /opt/jk-display/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
